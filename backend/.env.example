# Copy this file to backend/.env and fill it in. backend/.env is gitignored: never commit real keys.
# On DigitalOcean App Platform, add these as environment variables instead (tick "Encrypt" for secrets).

# Snowflake: account identifier from Snowsight (your name → account → View account details),
# and the token printed by snowflake/setup.sql.
SNOWFLAKE_ACCOUNT=ABCDEFG-XY12345
SNOWFLAKE_USER=LIFTR_BACKEND
SNOWFLAKE_PAT=
SNOWFLAKE_ROLE=LIFTR_APP_ROLE
SNOWFLAKE_WAREHOUSE=LIFTR_WH
SNOWFLAKE_DATABASE=LIFTR
SNOWFLAKE_SCHEMA=APP

# DigitalOcean Gradient serverless inference: control panel → serverless inference → Model Access Keys.
DO_MODEL_ACCESS_KEY=
DO_MODEL_ID=llama3.3-70b-instruct

# ElevenLabs: API key from your account settings, and the agent ID (starts with agent_).
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=

# Optional. If set, the app must send it as the X-App-Token header.
# It only keeps out casual callers: anything built into the app can be pulled out of it.
APP_TOKEN=

PORT=8080
